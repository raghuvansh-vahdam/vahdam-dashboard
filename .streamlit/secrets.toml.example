# Template for app secrets.
# DO NOT fill this file with real values — copy it to secrets.toml (which is
# gitignored) for local development, OR paste each section into the
# Streamlit Community Cloud "Secrets" UI for production.

# Snowflake connection
[snowflake]
account   = "your_account_locator"
user      = "your_username"
password  = "your_password"
warehouse = "your_warehouse"
role      = "your_role"
database  = "VAHDAM_DB"
schema    = "MAPLEMONK"

# Shared password gate (anyone with this password can view the app)
[auth]
password  = "choose-a-strong-password"

# Optional: Claude API for the "Ask the data" feature on the CEO view
# [anthropic]
# api_key  = "sk-ant-..."

# Optional: Keepa API for the Price Tracker tab — https://keepa.com/#!api
# [keepa]
# api_key  = "your_keepa_api_key"
