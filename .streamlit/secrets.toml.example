# Template for Snowflake credentials.
# DO NOT fill this file with real values — copy it to secrets.toml (which is
# gitignored) for local development, OR paste the [snowflake] block into the
# Streamlit Community Cloud "Secrets" UI for production.

[snowflake]
account   = "your_account_locator"
user      = "your_username"
password  = "your_password"
warehouse = "your_warehouse"
role      = "your_role"
database  = "VAHDAM_DB"
schema    = "MAPLEMONK"
